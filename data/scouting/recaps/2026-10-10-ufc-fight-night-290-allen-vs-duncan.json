    }
   ],
   "written": "2026-10-12"
  },
  "andre-fili-kai-kamaka-iii": {
   "summary": "A close, fun first round: Kamaka pressured and landed combinations to the body, while Fili answered with a long jab and clinch knees and edged it. Twenty-two seconds into round 2, Fili staggered Kamaka with a left hook and knocked him out cold with a head kick.",
   "turning_point": "The left hook that set up the head kick, 22 seconds into round 2.",
   "sources": [
    {
     "outlet": "Sherdog",
     "url": "https://www.sherdog.com/news/news/UFC-Vegas-122-Allen-vs-Duncan-playbyplay-results-round-scoring-203155",
