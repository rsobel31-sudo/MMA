    }
   ],
   "written": "2026-10-12"
  },
  "otari-tanzilovi-malcolm-wellmaker": {
   "summary": "Wellmaker pressured and hurt Tanzilovi in round 1, dropping him with a body shot, but Tanzilovi survived, completed takedowns and edged the round on Sherdog's cards (MMA Mania gave it to Wellmaker). In round 2 Tanzilovi had a head kick blocked, came back with another that dropped Wellmaker even through his raised hand, and finished it with punches at 2:39.",
   "turning_point": "Round 1: Tanzilovi got through Wellmaker's best moment; the second head kick ended it.",
   "sources": [
    {
     "outlet": "Sherdog",
     "url": "https://www.sherdog.com/news/news/UFC-Vegas-122-Allen-vs-Duncan-playbyplay-results-round-scoring-203155",
